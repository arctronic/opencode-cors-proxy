# Copy to .env and edit. Never commit the real .env.
#
# Origins allowed to call the proxy. Comma-separated, no spaces. "*" allows any,
# which on a public host lets any website spend a caller's quota through you.
ALLOWED_ORIGINS=https://study.example.com

# Shared secret callers must send as x-proxy-token. This is what keeps a public
# deployment from being an open relay. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PROXY_TOKEN=

# Per-IP rate limit. Behind Cloudflare the IP comes from CF-Connecting-IP.
RATE_LIMIT=60
RATE_WINDOW_MS=60000

# Largest request body accepted, in bytes.
MAX_BODY_BYTES=1000000

# The opencode API this fronts.
UPSTREAM=https://opencode.ai/zen/go/v1
